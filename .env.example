# Copiá este archivo a .env y completá los valores. El server lo carga solo al arrancar.

# BTC Alerts — credenciales SMTP de Gmail para enviar los emails de alerta.
# Generá un App Password en https://myaccount.google.com/apppasswords
# (si alguna vez lo perdés/filtrás, revocalo ahí mismo y generá otro).
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password-de-gmail
SMTP_FROM=tu-cuenta@gmail.com

# Contraseña para acceder a tempo (necesaria si lo exponés a internet por un túnel).
# Cambiá el valor por la clave que quieras. Para entrar: usuario "tempo" + esta clave.
TEMPO_PASSWORD=cambia-esta-clave

# OJO: NO pongas DATABASE_URL acá — el server local debe seguir usando data/state.json.
# Los scripts de nube leen la URL desde data/.cloud-url.
